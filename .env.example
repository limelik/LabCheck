NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://localhost:5173
AUTO_APPROVE_VERIFIED_STUDENTS=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=labcheck_app
MYSQL_PASSWORD=
MYSQL_DATABASE=labcheck
MYSQL_ROOT_PASSWORD=

# Generate a random secret of at least 32 characters for production.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Use the SMTP settings provided by the university mail administrator.
MAIL_HOST=
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="LabCheck <no-reply@polytechnic.am>"
