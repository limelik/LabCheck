API_PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=labcheck_app
DB_PASSWORD=replace-with-your-local-password
DB_NAME=labcheck
# Generate once: openssl rand -hex 32. Must contain at least 32 characters.
AUTH_SECRET=
SESSION_HOURS=8
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:5173
# Only trusted proxy IPs/CIDRs; e.g. loopback for a same-host reverse proxy. Never trust arbitrary clients.
TRUST_PROXY=
# Existing account schema permits polytechnic.am. Do not expand without a reviewed schema/roster change.
UNIVERSITY_DOMAINS=polytechnic.am
# Real signup/reset emails: configure your sender provider below.
EMAIL_DELIVERY=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=true
# Optional local tests only: explicitly set EMAIL_DELIVERY=capture.
DEV_MAILBOX_DIR=.local-mailbox
DEV_SMTP_PORT=2525
# Outside the public web root; durable storage and backups are required in production.
UPLOAD_DIR=.private-uploads
UPLOAD_MAX_BYTES=10485760
# Set NODE_ENV=production and COOKIE_SECURE=true behind HTTPS in production.
# Use MySQL with verified native FK enforcement; see docs/database-integrity.md.
